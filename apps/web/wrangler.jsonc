{
  "name": "stopthebus",
  "main": "../worker/src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "routes": [{ "pattern": "stopthebus.bass.dev", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"],
  },
  "durable_objects": { "bindings": [{ "name": "GAME", "class_name": "Game" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }],
}
