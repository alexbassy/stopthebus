{
  "name": "@stopthebus/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && wrangler dev",
    "build": "esbuild src/index.ts --bundle --target=es2019 --format=esm --main-fields=browser,module,main --external:http --external:https --external:http2 --external:os --external:util --external:tty --external:node:* --outfile=dist/worker.js",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@stopthebus/shared": "workspace:*",
    "@splitbee/node": "^0.3.1",
    "faunadb": "^4.8.2",
    "human-readable-ids": "^1.0.4",
    "nanoid": "^3.2.0",
    "servertime": "^3.1.1",
    "worktop": "^0.7.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "esbuild": "^0.28.2",
    "wrangler": "^4.0.0"
  }
}
